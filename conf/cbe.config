// nf-core/configs: CBE.next, the CLIP Batch Environment at the Vienna BioCenter
params {
    config_profile_description = 'CBE.next cluster at the Vienna BioCenter (VBC), provided by nf-core/configs'
    config_profile_contact     = 'Erich Birngruber (@ebirn)'
    config_profile_url         = 'https://docs.vbc.ac.at/research-computing/cbe/nextflow/'
    igenomes_base              = '/resources/references/igenomes'
}

executor {
    queueSize         = 100
    submitRateLimit   = '5 sec'
    queueStatInterval = '2 min'
    exitReadTimeout   = '5 min'
}

process {
    executor       = 'slurm'
    cache          = 'lenient'
    resourceLimits = [
        memory: 7.5.TB,
        cpus: 192,
        time: 14.d,
    ]
    // Partition m only for tasks that need more memory than a c node has (m also has a minimum memory per job)
    queue          = { task.memory > 740.GB ? 'm' : 'c' }
    // QOS level from the time limit; the cluster's submit hook adds the partition prefix
    clusterOptions = { "--qos=${!task.time || task.time > 48.h ? (task.time ? 'long' : 'short') : task.time > 8.h ? 'medium' : task.time > 1.h ? 'short' : 'rapid'}" }

    withLabel: 'process_gpu' {
        queue            = 'g'
        clusterOptions   = { "--gres=gpu:nvidia_b200_1g.23gb:1 --qos=${!task.time || task.time > 48.h ? (task.time ? 'long' : 'short') : task.time > 8.h ? 'medium' : task.time > 1.h ? 'short' : 'rapid'}" }
        containerOptions = '--nv'
    }
}

singularity {
    enabled      = true
    autoMounts   = true
    pullTimeout  = '1 h'
    envWhitelist = 'CUDA_VISIBLE_DEVICES'
}
